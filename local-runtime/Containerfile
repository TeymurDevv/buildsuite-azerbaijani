RUN uv pip install --python /home/frappe/frappe-bench/env/bin/python --no-deps -e ./apps/buildsuite_core && \
    ln -s /home/frappe/frappe-bench/apps/buildsuite_core/buildsuite_core/public /home/frappe/frappe-bench/assets/buildsuite_core
